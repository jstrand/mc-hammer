[Unit]
Description=MC Hammer Minecraft server portal
# Wants (not Requires) so a docker upgrade that restarts dockerd does not stop the portal.
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
# Runs as root on purpose. The Minecraft containers write their world data as
# uid 1000, so a lesser user cannot delete servers/<id>/data (EACCES on unlink),
# and binding port 80 needs the privilege anyway. Managing the docker socket is
# already root-equivalent on this host, so this is a small step, not a new one.
User=root
# The portal resolves ./servers and web/static relative to the working directory.
WorkingDirectory=@INSTALL_DIR@
Environment=HOME=@INSTALL_DIR@
Environment=MC_HAMMER_PORT=@PORT@
EnvironmentFile=-/etc/default/mc-hammer
ExecStart=@INSTALL_DIR@/mc-hammer -port ${MC_HAMMER_PORT}
Restart=always
RestartSec=3

# Modest hardening only. Do NOT add CapabilityBoundingSet here: trimming root's
# capabilities drops CAP_DAC_OVERRIDE, which is precisely what lets the portal
# delete the container-owned files under servers/<id>/data.
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=@INSTALL_DIR@

[Install]
WantedBy=multi-user.target
